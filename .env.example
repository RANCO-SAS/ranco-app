EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_WS_URL=ws://localhost:8080

# Mapas (development build / APK / EAS). Android requiere Google Maps API key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=

# EAS Build: google-services.json va en el repo (config de cliente Firebase/FCM).
# Restringe la API key en Google Cloud → Android app (com.ranco.app + SHA del keystore).
# eas env:create --name EXPO_PUBLIC_API_URL --value "https://api.example.com" --environment preview --environment production
# eas env:create --name EXPO_PUBLIC_WS_URL --value "wss://api.example.com" --environment preview --environment production
# eas env:create --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID --value "..." --environment preview --environment production
# eas env:create --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS --value "..." --environment preview --environment production

# Auth: recuperación de contraseña abre la app en ranco://auth/reset-password
