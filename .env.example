EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Referencia del proyecto (ej. ivobohmthkqcxpbndxpk)
# SUPABASE_PROJECT_REF=

# Token de https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=

# Auth: recuperación de contraseña abre la app en ranco://auth/reset-password
# Configura SMTP en Supabase Dashboard → Authentication → Email (SMTP)
# y agrega ranco://auth/reset-password a Redirect URLs permitidas.

# Referencia del proyecto remoto
# SUPABASE_SITE_URL=ranco://auth/reset-password
