EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps (builds nativos / development build). Expo Go suele funcionar sin esto.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Referencia del proyecto (ej. ivobohmthkqcxpbndxpk)
# SUPABASE_PROJECT_REF=

# Token de https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=

# Google OAuth (configuración en Supabase, no en la app móvil)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Expo Go dev: site_url en Supabase debe coincidir con tu Metro URL.
# Ejemplo: exp://192.168.1.7:8081/--/auth/callback
# En builds con scheme ranco:// usar: ranco://auth/callback
# SUPABASE_SITE_URL=
