EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mapas (development build / APK / EAS). Android requiere Google Maps API key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=

# EAS Build: sube google-services.json como variable de archivo (no va al repo)
# eas env:create --name GOOGLE_SERVICES_JSON --type file --value ./google-services.json --environment preview --environment production
# eas env:create --name EXPO_PUBLIC_SUPABASE_URL --value "https://..." --environment preview --environment production
# eas env:create --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "..." --environment preview --environment production
# eas env:create --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID --value "..." --environment preview --environment production
# eas env:create --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS --value "..." --environment preview --environment production

# Referencia del proyecto (ej. ivobohmthkqcxpbndxpk)
# SUPABASE_PROJECT_REF=

# Token de https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=

# Auth: recuperación de contraseña abre la app en ranco://auth/reset-password
# En Supabase Dashboard → Authentication → Providers → Email: debe estar habilitado.
# Redirect URLs: ranco://auth/reset-password y ranco://**
# SMTP opcional en Authentication → Email (SMTP).

# Referencia del proyecto remoto
# SUPABASE_SITE_URL=ranco://auth/reset-password
